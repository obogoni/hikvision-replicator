<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure logic only: no Docker, no host, no database. Anything that needs those
         belongs in HikvisionReplicator.IntegrationTests. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Not used by the tests directly, but the Api reference drags EF Core in at two
         versions at once; pinning to the one the Api compiles against is what keeps
         MSB3277 assembly-conflict warnings out of the build. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HikvisionReplicator.Api\HikvisionReplicator.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The face-picture fixture bank lives outside the solution tree (tests/assets) because
         both test projects use it and neither owns it. Linked in as copied content rather than
         becoming a fifth project. PROVENANCE.md and the generator stay behind. -->
    <Content Include="..\..\tests\assets\*.jpg;..\..\tests\assets\*.png;..\..\tests\assets\*.bin">
      <Link>assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
